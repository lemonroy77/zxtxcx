<view class="page data-v-0c2888da"><view class="search-bar data-v-0c2888da"><view class="search-input-wrap data-v-0c2888da"><text class="search-icon data-v-0c2888da">Q</text><input class="search-input data-v-0c2888da" placeholder="输入企业名称关键字进行搜索" placeholder-class="search-placeholder" data-event-opts="{{[['input',[['__set_model',['','keyword','$event',[]]],['onSearch',['$event']]]]]}}" value="{{keyword}}" bindinput="__e"/></view><view data-event-opts="{{[['tap',[['onFilter',['$event']]]]]}}" class="filter-btn data-v-0c2888da" bindtap="__e"><text class="filter-icon data-v-0c2888da">V</text><text class="filter-text data-v-0c2888da">筛选</text></view></view><view class="record-tip data-v-0c2888da"><text class="record-tip-text data-v-0c2888da">{{"共找到"+$root.g0+"条记录"}}</text></view><scroll-view class="list-scroll data-v-0c2888da" scroll-y="{{true}}"><block wx:for="{{filteredList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onCardClick',[index]]]]]}}" class="card data-v-0c2888da" bindtap="__e"><view class="card-info data-v-0c2888da"><text class="card-name data-v-0c2888da">{{item.companyName}}</text><text class="card-detail data-v-0c2888da">{{"行业及工艺流程："+item.industry+" / "+item.processes}}</text><text class="card-time data-v-0c2888da">{{"创建时间："+item.createTime}}</text></view><view data-event-opts="{{[['tap',[['onDelete',[index]]]]]}}" class="card-delete data-v-0c2888da" bindtap="__e"><text class="card-delete-text data-v-0c2888da">删除</text></view></view></block><view class="no-more data-v-0c2888da"><text class="no-more-text data-v-0c2888da">没有更多记录</text></view></scroll-view><view class="bottom-btn-area data-v-0c2888da"><view data-event-opts="{{[['tap',[['onCreate',['$event']]]]]}}" class="create-btn data-v-0c2888da" bindtap="__e"><text class="create-btn-text data-v-0c2888da">创建转型主体</text></view></view></view>