
.page.data-v-69f65188 {
	min-height: 100vh;
	background-color: #F5F5F5;
	padding: 0 0 200rpx;
}

/* 表单项 */
.form-item.data-v-69f65188 {
	background-color: #FFFFFF;
	padding: 30rpx;
	border-bottom: 1rpx solid #F0F0F0;
}
.form-label.data-v-69f65188 {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
}
.required.data-v-69f65188 {
	color: #E53935;
	font-size: 28rpx;
	margin-right: 6rpx;
}
.label-text.data-v-69f65188 {
	font-size: 30rpx;
	font-weight: bold;
	color: #333333;
}

/* 只读字段 */
.form-readonly.data-v-69f65188 {
	padding: 16rpx 0;
}
.readonly-value.data-v-69f65188 {
	font-size: 28rpx;
	color: #666666;
}

/* 选择器 */
.form-select.data-v-69f65188 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 16rpx 0;
}
.select-value.data-v-69f65188 {
	font-size: 28rpx;
	color: #333333;
	flex: 1;
}
.placeholder.data-v-69f65188 {
	color: #CCCCCC;
	font-size: 28rpx;
}
.arrow.data-v-69f65188 {
	color: #CCCCCC;
	font-size: 28rpx;
	margin-left: 16rpx;
}

/* 说明文字 */
.desc-area.data-v-69f65188 {
	padding: 30rpx;
}
.desc-text.data-v-69f65188 {
	font-size: 26rpx;
	color: #999999;
	line-height: 40rpx;
}

/* 底部按钮区（固定底部） */
.bottom-area.data-v-69f65188 {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #FFFFFF;
	padding: 20rpx 30rpx;
	padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
	z-index: 100;
}
.btn-row.data-v-69f65188 {
	display: flex;
	align-items: center;
	gap: 20rpx;
}
.abandon-btn.data-v-69f65188 {
	flex: 1;
	height: 88rpx;
	border: 2rpx solid #999999;
	border-radius: 44rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #FFFFFF;
}
.abandon-btn-text.data-v-69f65188 {
	color: #999999;
	font-size: 28rpx;
}
.save-btn.data-v-69f65188 {
	flex: 1;
	height: 88rpx;
	border: 2rpx solid #4CAF50;
	border-radius: 44rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #FFFFFF;
}
.save-btn-text.data-v-69f65188 {
	color: #4CAF50;
	font-size: 28rpx;
}
.next-btn.data-v-69f65188 {
	flex: 1;
	height: 88rpx;
	background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
	border-radius: 44rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.next-btn-text.data-v-69f65188 {
	color: #FFFFFF;
	font-size: 28rpx;
}

/* 中间弹窗 */
.mask.data-v-69f65188 {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.5);
	z-index: 999;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup.data-v-69f65188 {
	width: 620rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
	max-height: 70vh;
	overflow: hidden;
}
.center-popup-header.data-v-69f65188 {
	padding: 30rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.center-popup-title-text.data-v-69f65188 {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
}
.center-popup-cancel.data-v-69f65188 {
	font-size: 28rpx;
	color: #999999;
}

/* 搜索框 */
.popup-search.data-v-69f65188 {
	display: flex;
	align-items: center;
	margin: 0 30rpx 20rpx;
	background-color: #F5F5F5;
	border-radius: 36rpx;
	padding: 16rpx 24rpx;
}
.popup-search-icon.data-v-69f65188 {
	font-size: 28rpx;
	color: #999999;
	margin-right: 12rpx;
}
.popup-search-input.data-v-69f65188 {
	flex: 1;
	font-size: 26rpx;
	color: #333333;
}
.popup-search-placeholder.data-v-69f65188 {
	color: #CCCCCC;
	font-size: 26rpx;
}
.center-popup-list.data-v-69f65188 {
	max-height: 400rpx;
}
.center-popup-item.data-v-69f65188 {
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid #F5F5F5;
}
.center-popup-item.data-v-69f65188:last-child {
	border-bottom: none;
}
.center-popup-item-selected.data-v-69f65188 {
	background-color: #F0FAF0;
}
.center-popup-item-name.data-v-69f65188 {
	font-size: 28rpx;
	color: #333333;
	font-weight: bold;
}
.center-popup-item-name-active.data-v-69f65188 {
	color: #4CAF50;
}
.center-popup-item-info.data-v-69f65188 {
	font-size: 24rpx;
	color: #999999;
	margin-top: 12rpx;
}
.center-popup-item-detail.data-v-69f65188 {
	font-size: 24rpx;
	color: #666666;
	margin-top: 4rpx;
	line-height: 36rpx;
}
.center-popup-empty.data-v-69f65188 {
	padding: 60rpx 0;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup-empty-text.data-v-69f65188 {
	font-size: 28rpx;
	color: #CCCCCC;
}
.center-popup-footer.data-v-69f65188 {
	padding: 20rpx 40rpx 36rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup-confirm-btn.data-v-69f65188 {
	width: 240rpx;
	height: 80rpx;
	background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
	border-radius: 40rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup-confirm-text.data-v-69f65188 {
	color: #FFFFFF;
	font-size: 30rpx;
	font-weight: bold;
}

