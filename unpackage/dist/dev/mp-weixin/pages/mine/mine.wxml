<view class="page data-v-dcbcfe34"><view class="header-bg data-v-dcbcfe34"><view style="{{'height:'+(statusBarHeight+'px')+';'}}" class="data-v-dcbcfe34"></view><view data-event-opts="{{[['tap',[['onUserClick',['$event']]]]]}}" class="user-section data-v-dcbcfe34" bindtap="__e"><image class="avatar data-v-dcbcfe34" src="{{userInfo.avatar||'/static/icons/icon-avatar-default.png'}}" mode="aspectFill"></image><block wx:if="{{isLoggedIn}}"><view class="user-detail data-v-dcbcfe34"><text class="user-name data-v-dcbcfe34">{{userInfo.nickname||'绿易融用户'}}</text><text class="user-sub data-v-dcbcfe34">{{phoneDisplay}}</text></view></block><block wx:else><view class="user-detail data-v-dcbcfe34"><text class="user-name data-v-dcbcfe34">登录 / 注册</text><text class="user-sub data-v-dcbcfe34">登录后享受更多服务</text></view></block></view></view><block wx:if="{{isLoggedIn}}"><view class="status-float-card data-v-dcbcfe34"><view class="sf-row data-v-dcbcfe34"><view class="{{['sf-icon-wrap','data-v-dcbcfe34','sf-'+auditStatus]}}"><text class="sf-icon-text data-v-dcbcfe34">{{statusIcon}}</text></view><view class="sf-info data-v-dcbcfe34"><text class="sf-label data-v-dcbcfe34">{{auditStatusText}}</text><text class="sf-desc data-v-dcbcfe34">{{auditDesc}}</text></view></view></view></block><block wx:if="{{isLoggedIn&&auditStatus==='passed'}}"><view class="card data-v-dcbcfe34"><view class="card-head data-v-dcbcfe34"><text class="card-title data-v-dcbcfe34">报告文件</text><text class="card-count data-v-dcbcfe34">{{$root.g0+"份"}}</text></view><view class="report-list data-v-dcbcfe34"><block wx:for="{{reportList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="report-item data-v-dcbcfe34" hover-class="report-item-hover" data-event-opts="{{[['tap',[['onDownloadReport',['$0'],[[['reportList','',index]]]]]]]}}" bindtap="__e"><view class="report-icon data-v-dcbcfe34"><text class="report-icon-label data-v-dcbcfe34">PDF</text></view><view class="report-detail data-v-dcbcfe34"><text class="report-name data-v-dcbcfe34">{{item.name}}</text><text class="report-size data-v-dcbcfe34">{{item.size}}</text></view><view class="report-dl-btn data-v-dcbcfe34"><text class="report-dl-text data-v-dcbcfe34">下载</text></view></view></block></view></view></block><view class="card data-v-dcbcfe34"><block wx:for="{{menuList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="list-item data-v-dcbcfe34" hover-class="list-item-hover" data-event-opts="{{[['tap',[['onMenuClick',['$0'],[[['menuList','',index]]]]]]]}}" bindtap="__e"><view class="list-left data-v-dcbcfe34"><view class="list-icon-wrap data-v-dcbcfe34" style="{{'background:'+(item.bg)+';'}}"><image class="list-icon data-v-dcbcfe34" src="{{item.icon}}" mode="aspectFit"></image></view><text class="list-text data-v-dcbcfe34">{{item.name}}</text></view><text class="list-arrow data-v-dcbcfe34">❯</text></view></block></view><view class="divider-gap data-v-dcbcfe34"></view><view class="card data-v-dcbcfe34"><block wx:for="{{settingList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="list-item data-v-dcbcfe34" hover-class="list-item-hover" data-event-opts="{{[['tap',[['onMenuClick',['$0'],[[['settingList','',index]]]]]]]}}" bindtap="__e"><view class="list-left data-v-dcbcfe34"><view class="list-icon-wrap data-v-dcbcfe34" style="{{'background:'+(item.bg)+';'}}"><image class="list-icon data-v-dcbcfe34" src="{{item.icon}}" mode="aspectFit"></image></view><text class="list-text data-v-dcbcfe34">{{item.name}}</text></view><text class="list-arrow data-v-dcbcfe34">❯</text></view></block></view><block wx:if="{{isLoggedIn}}"><view class="logout-wrap data-v-dcbcfe34"><view class="logout-btn data-v-dcbcfe34" hover-class="logout-btn-hover" data-event-opts="{{[['tap',[['onLogout',['$event']]]]]}}" bindtap="__e"><text class="logout-text data-v-dcbcfe34">退出登录</text></view></view></block><view style="height:30rpx;" class="data-v-dcbcfe34"></view></view>