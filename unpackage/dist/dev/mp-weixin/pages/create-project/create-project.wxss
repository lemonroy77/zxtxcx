
.page.data-v-dbe49074 {
	min-height: 100vh;
	background-color: #F5F5F5;
	padding: 0 0 200rpx;
}

/* 表单项 */
.form-item.data-v-dbe49074 {
	background-color: #FFFFFF;
	padding: 30rpx;
	border-bottom: 1rpx solid #F0F0F0;
}
.form-label.data-v-dbe49074 {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
}
.required.data-v-dbe49074 {
	color: #E53935;
	font-size: 28rpx;
	margin-right: 6rpx;
}
.label-text.data-v-dbe49074 {
	font-size: 30rpx;
	font-weight: bold;
	color: #333333;
}
.label-tip.data-v-dbe49074 {
	font-size: 24rpx;
	color: #999999;
	margin-left: 8rpx;
}
.form-input.data-v-dbe49074 {
	font-size: 28rpx;
	color: #333333;
	padding: 16rpx 0;
}
.placeholder.data-v-dbe49074 {
	color: #CCCCCC;
	font-size: 28rpx;
}

/* 只读字段 */
.form-readonly.data-v-dbe49074 {
	padding: 16rpx 0;
}
.readonly-value.data-v-dbe49074 {
	font-size: 28rpx;
	color: #666666;
}

/* 选择器 */
.form-select.data-v-dbe49074 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 16rpx 0;
}
.select-value.data-v-dbe49074 {
	font-size: 28rpx;
	color: #333333;
	flex: 1;
}
.arrow.data-v-dbe49074 {
	color: #CCCCCC;
	font-size: 28rpx;
	margin-left: 16rpx;
}

/* 上传区 */
.upload-area.data-v-dbe49074 {
	display: flex;
	align-items: center;
	padding: 20rpx 0;
}
.upload-box.data-v-dbe49074 {
	width: 120rpx;
	height: 120rpx;
	border: 2rpx dashed #CCCCCC;
	border-radius: 12rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
	flex-shrink: 0;
}
.upload-icon.data-v-dbe49074 {
	font-size: 48rpx;
	color: #CCCCCC;
}
.upload-tip.data-v-dbe49074 {
	font-size: 24rpx;
	color: #999999;
	line-height: 36rpx;
}
.upload-note.data-v-dbe49074 {
	padding: 12rpx 0 0;
}
.upload-note-text.data-v-dbe49074 {
	font-size: 24rpx;
	color: #999999;
}

/* 底部按钮区（固定底部） */
.bottom-area.data-v-dbe49074 {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #FFFFFF;
	padding: 20rpx 30rpx;
	padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
	z-index: 100;
}
.btn-row.data-v-dbe49074 {
	display: flex;
	align-items: center;
	gap: 20rpx;
}
.abandon-btn.data-v-dbe49074 {
	flex: 1;
	height: 88rpx;
	border: 2rpx solid #999999;
	border-radius: 44rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #FFFFFF;
}
.abandon-btn-text.data-v-dbe49074 {
	color: #999999;
	font-size: 28rpx;
}
.save-btn.data-v-dbe49074 {
	flex: 1;
	height: 88rpx;
	border: 2rpx solid #4CAF50;
	border-radius: 44rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #FFFFFF;
}
.save-btn-text.data-v-dbe49074 {
	color: #4CAF50;
	font-size: 28rpx;
}
.submit-btn.data-v-dbe49074 {
	flex: 1;
	height: 88rpx;
	background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
	border-radius: 44rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.submit-btn-text.data-v-dbe49074 {
	color: #FFFFFF;
	font-size: 28rpx;
}

/* 中间弹窗 */
.mask.data-v-dbe49074 {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.5);
	z-index: 999;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup.data-v-dbe49074 {
	width: 580rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
	max-height: 70vh;
	overflow: hidden;
}
.center-popup-title.data-v-dbe49074 {
	padding: 36rpx 30rpx 20rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup-title-text.data-v-dbe49074 {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
}
.center-popup-header.data-v-dbe49074 {
	padding: 30rpx;
	display: flex;
	align-items: center;
}
.center-popup-cancel.data-v-dbe49074 {
	font-size: 28rpx;
	color: #999999;
}
.center-popup-list.data-v-dbe49074 {
	max-height: 500rpx;
}
.center-popup-item.data-v-dbe49074 {
	padding: 28rpx 40rpx;
	border-bottom: 1rpx solid #F5F5F5;
}
.center-popup-item.data-v-dbe49074:last-child {
	border-bottom: none;
}
.center-popup-item-text.data-v-dbe49074 {
	font-size: 28rpx;
	color: #333333;
}
.center-popup-item-active.data-v-dbe49074 {
	color: #4CAF50;
	font-weight: bold;
}
.center-popup-footer.data-v-dbe49074 {
	padding: 20rpx 40rpx 36rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup-confirm-btn.data-v-dbe49074 {
	width: 240rpx;
	height: 80rpx;
	background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
	border-radius: 40rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.center-popup-confirm-text.data-v-dbe49074 {
	color: #FFFFFF;
	font-size: 30rpx;
	font-weight: bold;
}

